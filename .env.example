# Copy to `.env` before running `docker compose up`.
#
#   cp .env.example .env

# Used by docker-compose.yaml to configure the db and app services.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=houses

# Used when running the API directly with `uv run`, outside Docker Compose.
# Leave this unset entirely and the app falls back to a local SQLite file,
# which is the quickest way to try the API without starting a database.
# DB_CONN=postgresql+psycopg://postgres:postgres@localhost:5432/houses
